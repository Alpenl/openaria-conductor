[Unit]
Description=Open Aria /data internal recording volume
DefaultDependencies=no
Requires=rp-ylx-recover.service
After=local-fs.target rp-ylx-recover.service
Before=rp-ylx.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rp-ylx-data-volume ensure
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rp-ylx-data-volume

[Install]
WantedBy=multi-user.target
