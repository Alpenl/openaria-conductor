[Unit]
Description=RP-YLX /data internal recording volume
DefaultDependencies=no
Requires=rp-ylx-recover.service
After=local-fs.target rp-ylx-recover.service
Before=rp-ylx.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rp-ylx-data-volume ensure

[Install]
WantedBy=multi-user.target
