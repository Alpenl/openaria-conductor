#!/usr/bin/env bash
set -euo pipefail

SIZE="${RP_YLX_DATA_VOLUME_SIZE:-80G}"
IMAGE="${RP_YLX_DATA_VOLUME_IMAGE:-/var/lib/rp-ylx-data-volume/data-volume.img}"
MOUNT="${RP_YLX_DATA_VOLUME_MOUNT:-/data}"
OWNER="${RP_YLX_DATA_VOLUME_OWNER:-rp-ylx:rp-ylx}"

log() {
    printf '[rp-ylx-data-volume] %s\n' "$*"
}

usage() {
    echo "usage: $0 ensure" >&2
}

case "${1:-ensure}" in
    ensure) ;;
    *) usage; exit 2 ;;
esac

getent passwd rp-ylx >/dev/null || {
    echo 'rp-ylx user is missing' >&2
    exit 1
}

# Existing installations retain their loop volume. Only factory provisioned
# cards opt into partition mode; a failed partition must never create an image.
case "${RP_YLX_DATA_VOLUME_MODE:-loop}" in
    exfat)
        partuuid="${RP_YLX_DATA_VOLUME_PARTUUID:?missing recording partition identity}"
        [[ "$partuuid" =~ ^[[:xdigit:]]{8}-03$ ]] || exit 1
        uuid="${RP_YLX_DATA_VOLUME_UUID:?missing recording filesystem identity}"
        [[ "$uuid" =~ ^[[:xdigit:]]{4}-[[:xdigit:]]{4}$ ]] || exit 1
        device="/dev/disk/by-uuid/$uuid"
        [ -b "$device" ] || { log 'recording partition is absent'; exit 1; }
        [ "$(blkid -s PARTUUID -o value "$device")" = "$partuuid" ] || exit 1
        [ "$(blkid -s TYPE -o value "$device")" = exfat ] || exit 1
        capture_uid="$(id -u rp-ylx)"
        capture_gid="$(id -g rp-ylx)"
        if ! mountpoint -q "$MOUNT"; then
            install -d -o root -g root -m 0755 "$MOUNT"
            # Safe automatic repairs only; never format a damaged data volume.
            # A failed/timed-out repair leaves the web service available.
            rc=0
            timeout --kill-after=5s 90s fsck.exfat -p "$device" || rc=$?
            [ "$rc" = 0 ] || [ "$rc" = 1 ] || exit "$rc"
            mount -t exfat -o "rw,nosuid,nodev,noexec,noatime,uid=$capture_uid,gid=$capture_gid,fmask=0137,dmask=0027,errors=remount-ro" "$device" "$MOUNT"
        fi
        [ "$(findmnt -rn --mountpoint "$MOUNT" -o FSTYPE)" = exfat ] || exit 1
        source="$(findmnt -rn --mountpoint "$MOUNT" -o SOURCE)"
        [ "$(readlink -f "$source")" = "$(readlink -f "$device")" ] || exit 1
        if [ ! -f "$MOUNT/.ylx-volume.json" ]; then
            runuser -u rp-ylx -- /opt/rp-ylx/current/bin/rp-ylx volume init "$MOUNT"
        fi
        runuser -u rp-ylx -- mkdir -p "$MOUNT/recordings" "$MOUNT/sessions"
        log "ready: $device exFAT at $MOUNT"
        exit 0
        ;;
    loop)
        if [ -e /var/lib/openaria-factory/firstboot/storage.json ]; then
            log 'factory partition configuration is missing; refusing loop fallback'
            exit 1
        fi
        ;;
    *) log 'unknown storage mode'; exit 1 ;;
esac

install -d -o root -g root -m 0755 "$(dirname "$IMAGE")"
if [ ! -e "$IMAGE" ]; then
    log "creating $SIZE ext4 image at $IMAGE"
    fallocate -l "$SIZE" "$IMAGE"
    chmod 0600 "$IMAGE"
    # Do not discard the freshly allocated file: the backing root filesystem must
    # reserve the data-volume blocks up front rather than overcommit system space.
    mkfs.ext4 -F -E nodiscard -L OPENARIA-DATA "$IMAGE" >/dev/null
elif [ ! -f "$IMAGE" ]; then
    echo "$IMAGE exists but is not a regular file" >&2
    exit 1
fi

install -d -o root -g root -m 0755 "$MOUNT"
if ! mountpoint -q "$MOUNT"; then
    log "mounting $IMAGE at $MOUNT"
    mount -o loop,rw "$IMAGE" "$MOUNT"
fi

chown "$OWNER" "$MOUNT"
chmod 0750 "$MOUNT"
if [ ! -f "$MOUNT/.ylx-volume.json" ]; then
    log 'initializing capture volume identity'
    runuser -u rp-ylx -- /opt/rp-ylx/current/bin/rp-ylx volume init "$MOUNT"
fi
install -d -o rp-ylx -g rp-ylx -m 0750 "$MOUNT/recordings"
# Keep the old generation root readable so upgraded devices can still list and
# download sessions captured before the /data/recordings migration.
install -d -o rp-ylx -g rp-ylx -m 0750 "$MOUNT/sessions"
# chown updates ctime even when ownership already matches. Rewriting every
# manifest on boot invalidates the persistent catalog and forces full validation
# of all historical recordings on the first list request. Repair only mismatches;
# do not follow symlinks or cross into another mounted filesystem.
capture_uid="$(id -u rp-ylx)"
capture_gid="$(id -g rp-ylx)"
find -P "$MOUNT/.ylx-volume.json" "$MOUNT/sessions" "$MOUNT/recordings" -xdev \
    \( ! -uid "$capture_uid" -o ! -gid "$capture_gid" \) \
    -exec chown -h "$capture_uid:$capture_gid" {} +
log "ready: $(findmnt -rn --mountpoint "$MOUNT" -o TARGET,SOURCE,FSTYPE,OPTIONS)"
df -hT "$MOUNT"
