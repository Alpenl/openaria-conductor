[Unit]
Description=Recover interrupted Open Aria release transaction
After=local-fs.target systemd-tmpfiles-setup.service
Before=rp-ylx-data-volume.service rp-ylx-network-control.service rp-ylx.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/rp-ylx-deploy recover --service-start
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rp-ylx-recover
TimeoutStartSec=120s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/rp-ylx
ReadWritePaths=/var/lib/rp-ylx
ReadWritePaths=/var/lib/openaria-update
ReadWritePaths=/etc/rp-ylx
ReadWritePaths=-/etc/avahi/services
ReadWritePaths=/usr/local/lib/rp-ylx
ReadWritePaths=/usr/local/lib/openaria
ReadWritePaths=/usr/local/sbin
ReadWritePaths=/usr/lib/systemd/system
ReadWritePaths=/usr/lib/sysusers.d
ReadWritePaths=/usr/lib/tmpfiles.d
ReadWritePaths=-/etc/systemd/system/fstrim.service.d
ReadWritePaths=-/etc/modprobe.d
ReadWritePaths=-/etc/NetworkManager/conf.d
ReadWritePaths=/etc/default
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
