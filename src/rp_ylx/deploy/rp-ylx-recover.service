[Unit]
Description=Recover interrupted RP-YLX release transaction
After=local-fs.target
Before=rp-ylx-data-volume.service rp-ylx-network-control.service rp-ylx.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/rp-ylx-deploy recover
TimeoutStartSec=120s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/rp-ylx
ReadWritePaths=/var/lib/rp-ylx
ReadWritePaths=/etc/rp-ylx
ReadWritePaths=/etc/avahi/services
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
