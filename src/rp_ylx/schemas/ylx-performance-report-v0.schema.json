{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ylx:schema:performance-report:v0",
  "title": "RDK X5 性能报告 v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "observed_at",
    "identity",
    "environment",
    "workload",
    "native",
    "stages",
    "copies",
    "queue",
    "loss",
    "resources",
    "result"
  ],
  "properties": {
    "format": { "const": "ylx.performance-report.v0" },
    "observed_at": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "wheel_sha256", "software_version"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "wheel_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "software_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "machine", "kernel", "python", "target"],
      "properties": {
        "evidence_kind": { "enum": ["hardware", "fixed_trace", "fixture"] },
        "machine": { "type": "string", "minLength": 1, "maxLength": 64 },
        "kernel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "python": { "type": "string", "minLength": 1, "maxLength": 64 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["board", "camera", "supported"],
          "properties": {
            "board": { "type": "string", "minLength": 1, "maxLength": 64 },
            "camera": { "type": "string", "minLength": 1, "maxLength": 64 },
            "supported": { "type": "boolean" }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "round",
        "duration_ns",
        "frames_input",
        "frames_output",
        "mode"
      ],
      "properties": {
        "kind": { "enum": ["fixed_trace", "preview", "recording", "concurrent"] },
        "round": { "type": "integer", "minimum": 1 },
        "duration_ns": { "type": "integer", "minimum": 1 },
        "frames_input": { "type": "integer", "minimum": 0 },
        "frames_output": { "type": "integer", "minimum": 0 },
        "mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "fps", "encoding"],
          "properties": {
            "width": { "const": 3840 },
            "height": { "const": 1080 },
            "fps": { "const": 60 },
            "encoding": { "const": "mjpg" }
          }
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "module_available", "module_version", "abi"],
      "properties": {
        "adapter": { "enum": ["python", "rust"] },
        "module_available": { "type": "boolean" },
        "module_version": { "type": ["string", "null"], "maxLength": 64 },
        "abi": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage" }
    },
    "copies": {
      "type": "array",
      "items": { "$ref": "#/$defs/copy" }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "peak_depth", "rejected"],
      "properties": {
        "capacity": { "type": "integer", "minimum": 1 },
        "peak_depth": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 }
      }
    },
    "loss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_gap", "application_drop", "unknown_gap"],
      "properties": {
        "source_gap": { "type": "integer", "minimum": 0 },
        "application_drop": { "type": "integer", "minimum": 0 },
        "unknown_gap": { "type": "integer", "minimum": 0 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_time_ns", "rss_peak_bytes", "bytes_written"],
      "properties": {
        "cpu_time_ns": { "type": "integer", "minimum": 0 },
        "rss_peak_bytes": { "type": "integer", "minimum": 0 },
        "bytes_written": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_fps"],
      "properties": {
        "effective_fps": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "metricName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "samples", "p50_ns", "p95_ns", "total_ns"],
      "properties": {
        "name": { "$ref": "#/$defs/metricName" },
        "samples": { "type": "integer", "minimum": 1 },
        "p50_ns": { "type": "integer", "minimum": 0 },
        "p95_ns": { "type": "integer", "minimum": 0 },
        "total_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count", "bytes_total"],
      "properties": {
        "name": { "$ref": "#/$defs/metricName" },
        "count": { "type": "integer", "minimum": 0 },
        "bytes_total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
