{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ylx:schema:operational-event:v1",
  "title": "Open Aria operational event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "timestamp",
    "level",
    "component",
    "event",
    "version",
    "commit",
    "context"
  ],
  "properties": {
    "schema": {"const": "ylx.operational-event.v1"},
    "timestamp": {"type": "string", "format": "date-time"},
    "level": {"enum": ["debug", "info", "warning", "error", "critical"]},
    "component": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "event": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "commit": {"type": "string", "minLength": 1, "maxLength": 128},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address_count": {"type": "integer", "minimum": 0},
        "active_transaction": {"type": "boolean"},
        "ap_validated": {"type": "boolean"},
        "connections_served": {"type": "integer", "minimum": 0},
        "data_plane": {"$ref": "#/$defs/safeString"},
        "desired_mode": {"$ref": "#/$defs/safeString"},
        "duration_ms": {"type": "number", "minimum": 0},
        "error_code": {"$ref": "#/$defs/safeString"},
        "exception_type": {"$ref": "#/$defs/safeString"},
        "exit_code": {"type": "integer", "minimum": 0},
        "fallback_error_code": {"$ref": "#/$defs/safeString"},
        "frames_published": {"type": "integer", "minimum": 0},
        "grace_seconds": {"type": "number", "minimum": 0},
        "kind": {"$ref": "#/$defs/safeString"},
        "new_boot": {"type": "boolean"},
        "operation": {"$ref": "#/$defs/safeString"},
        "outcome": {"$ref": "#/$defs/safeString"},
        "poll_seconds": {"type": "number", "minimum": 0},
        "port": {"type": "integer", "minimum": 0},
        "reason": {"$ref": "#/$defs/safeString"},
        "recovery_action": {"$ref": "#/$defs/safeString"},
        "redacted_field_count": {"type": "integer", "minimum": 1},
        "replayed": {"type": "boolean"},
        "retryable": {"type": "boolean"},
        "rescue_error_code": {"$ref": "#/$defs/safeString"},
        "saved": {"type": "boolean"},
        "scheme": {"$ref": "#/$defs/safeString"},
        "security_profile": {"$ref": "#/$defs/safeString"},
        "signal": {"$ref": "#/$defs/safeString"},
        "source_revision": {"type": "integer", "minimum": 0},
        "stage": {"$ref": "#/$defs/safeString"},
        "status": {"$ref": "#/$defs/safeString"},
        "suppressed_count": {"type": "integer", "minimum": 0},
        "transaction_id": {"$ref": "#/$defs/safeString"},
        "transport": {"$ref": "#/$defs/safeString"},
        "ttl_seconds": {"type": "number", "minimum": 0},
        "verified": {"type": "boolean"},
        "worker_enabled": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "safeString": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,127}$"
    }
  }
}
