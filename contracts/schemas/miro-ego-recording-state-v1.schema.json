{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miro-ego:schema:recording-state:v1",
  "title": "Miro-Ego Recording State v1",
  "description": "Operational state for an active or unsuccessful capture session. recoverable, failed, and abandoned are immutable terminal outcomes and never become sealed completion markers. This schema defines no salvage transition or recovery provenance; any future salvage flow requires a separate versioned recovery contract, attempt identity, and output namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "authority_epoch",
    "state_revision",
    "updated_at",
    "session_id",
    "take_id",
    "display_name",
    "device",
    "storage",
    "progress",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "miro-ego.recording-state.v1"
    },
    "state": {
      "enum": [
        "recording",
        "finalizing",
        "encoding",
        "verifying",
        "recoverable",
        "failed",
        "abandoned"
      ]
    },
    "authority_epoch": {
      "$ref": "#/$defs/uuidV4",
      "description": "Daemon authority lifetime that committed these exact Recording State bytes. Preserved across normal restarts; renewed on a newly authorized authority lifetime."
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Daemon source_revision within authority_epoch that committed these exact Recording State bytes. Never an SSE delivery ID and never sent as Last-Event-ID."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "$ref": "#/$defs/uuidV7"
    },
    "take_id": {
      "$ref": "#/$defs/uuidV7"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "device": {
      "$ref": "#/$defs/deviceIdentity"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume_id",
        "status",
        "writable",
        "remaining_bytes"
      ],
      "properties": {
        "volume_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "status": {
          "enum": [
            "mounted",
            "sealing",
            "media_lost"
          ],
          "description": "Storage status while a session is active or unsuccessful. Orderly volume release is represented exclusively by a versioned safe-swap handoff receipt; media_lost indicates unexpected medium removal before orderly handoff."
        },
        "writable": {
          "type": "boolean"
        },
        "remaining_bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "media_lost"
              }
            }
          },
          "then": {
            "properties": {
              "writable": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_seconds",
        "captured_frames",
        "bytes_written"
      ],
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "captured_frames": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_written": {
          "type": "integer",
          "minimum": 0
        },
        "verification": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "abandonment": {
      "$ref": "#/$defs/abandonment"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "recoverable"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": [
                "recoverable"
              ],
              "properties": {
                "recoverable": {
                  "const": true
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "severity",
                "recoverable"
              ],
              "properties": {
                "severity": {
                  "const": "error"
                },
                "recoverable": {
                  "const": false
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "abandoned"
          }
        }
      },
      "then": {
        "required": [
          "abandonment"
        ],
        "properties": {
          "diagnostics": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "severity",
                "recoverable"
              ],
              "properties": {
                "severity": {
                  "const": "error"
                },
                "recoverable": {
                  "const": false
                }
              }
            },
            "minContains": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "abandonment"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "verifying"
          }
        }
      },
      "then": {
        "properties": {
          "progress": {
            "required": [
              "verification"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "storage"
        ],
        "properties": {
          "storage": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "media_lost"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "recoverable",
              "failed",
              "abandoned"
            ]
          },
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "const": "media_lost"
                }
              }
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Canonical lowercase UUIDv7."
    },
    "uuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Canonical lowercase random UUIDv4."
    },
    "deviceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "device_label"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "device_label": {
          "type": "string",
          "pattern": "^Miro-Ego-[0-9A-F]{8}$",
          "description": "Display-only device label."
        }
      }
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "total"
      ],
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "at",
        "recoverable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "recoverable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "description": "Explicit extension bag for diagnostic-specific machine data. Consumers must ignore unknown keys only inside this object.",
          "additionalProperties": true
        }
      }
    },
    "abandonment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "reason",
        "authorized_at",
        "authorization"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "authorized_at": {
          "type": "string",
          "format": "date-time"
        },
        "authorization": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "operator_id"
              ],
              "properties": {
                "kind": {
                  "const": "OPERATOR"
                },
                "operator_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                  "maxLength": 128
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "policy_id",
                "policy_revision",
                "policy_sha256"
              ],
              "properties": {
                "kind": {
                  "const": "POLICY"
                },
                "policy_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
                  "maxLength": 128
                },
                "policy_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "policy_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    }
  }
}
