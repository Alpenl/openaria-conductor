[Unit]
Description=Recover interrupted Miro-Ego release transaction
After=local-fs.target systemd-tmpfiles-setup.service
Before=miro-ego-data-volume.service miro-ego-network.service miro-ego.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
Environment=RUST_LOG=info
ExecStart=/opt/miro-ego/current/bin/miro-ego deploy recover --service-start
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=miro-ego-recover
TimeoutStartSec=120s
UMask=0022
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
