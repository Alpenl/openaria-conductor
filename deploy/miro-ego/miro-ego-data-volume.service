[Unit]
Description=Miro-Ego /data exFAT recording volume
DefaultDependencies=no
Requires=miro-ego-recover.service
After=local-fs.target miro-ego-recover.service systemd-udev-settle.service systemd-tmpfiles-setup.service
Wants=systemd-udev-settle.service
Before=miro-ego.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/miro-ego-data-volume
TimeoutStartSec=120s
ExecStart=/usr/local/sbin/miro-ego-data-volume ensure
StandardOutput=journal
StandardError=journal
SyslogIdentifier=miro-ego-data-volume

[Install]
WantedBy=multi-user.target
