[Unit]
Description=Miro-Ego RDK X5 stereo capture service
Requires=miro-ego-recover.service miro-ego-network.socket
Wants=miro-ego-data-volume.service miro-ego-network.service miro-ego-deploy.socket network-online.target
After=data.mount miro-ego-data-volume.service miro-ego-recover.service miro-ego-network.socket miro-ego-network.service miro-ego-deploy.socket network-online.target NetworkManager.service systemd-tmpfiles-setup.service

[Service]
Type=simple
User=miro-ego
Group=miro-ego
# audio carries ALSA capture/playback; vpu/jpu/vps carry codec nodes; misc carries the RDK X5 ION allocator.
SupplementaryGroups=audio video vpu jpu vps misc
Environment=MIRO_EGO_NETWORK_OPERATION_LOCK_PATH=/run/miro-ego/network-operation.lock
Environment=MIRO_EGO_MAINTENANCE_LOCK=/run/miro-ego/maintenance.lock
Environment=MIRO_EGO_ENCODER_BIN=/opt/miro-ego/current/bin/miro-ego-encoder
Environment=RUST_LOG=info
EnvironmentFile=-/etc/default/miro-ego-data-volume
ExecStart=/opt/miro-ego/current/bin/miro-ego serve --config /etc/miro-ego/device.json
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=miro-ego
Restart=on-failure
RestartSec=2s
TimeoutStopSec=60s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=no
ReadOnlyPaths=/proc/sys -/proc/sysrq-trigger -/proc/latency_stats -/proc/acpi -/proc/timer_stats -/proc/fs -/proc/irq
ProtectKernelModules=yes
ProtectControlGroups=yes
# Keep ProtectClock=no: on systemd 249 (Ubuntu 22.04 / RDK X5), ProtectClock=yes
# implicitly sets DevicePolicy=auto + DeviceAllow=char-rtc r, denying /dev/video*,
# /dev/ion, /dev/vpu, /dev/jpu, and /dev/snd/* with EPERM. CapabilityBoundingSet=
# already strips CAP_SYS_TIME.
ProtectClock=no
ProtectKernelLogs=yes
ProtectHostname=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/miro-ego
ReadWritePaths=-/data
ReadWritePaths=-/sys/class/leds
ReadWritePaths=/run/miro-ego
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
