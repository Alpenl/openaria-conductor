[Unit]
Description=Miro-Ego RDK X5 stereo capture service
Requires=miro-ego-recover.service miro-ego-network.socket miro-ego-network.service
After=miro-ego-data-volume.service miro-ego-recover.service miro-ego-network.socket miro-ego-network.service network-online.target NetworkManager.service systemd-tmpfiles-setup.service
Wants=miro-ego-data-volume.service network-online.target

[Service]
Type=simple
User=miro-ego
Group=miro-ego
# vpu/jpu/vps carry codec nodes; misc carries the RDK X5 ION allocator.
SupplementaryGroups=video vpu jpu vps misc
Environment=MIRO_EGO_NETWORK_OPERATION_LOCK_PATH=/run/miro-ego/network-operation.lock
Environment=MIRO_EGO_MAINTENANCE_LOCK=/run/miro-ego/maintenance.lock
Environment=MIRO_EGO_ENCODER_BIN=/opt/miro-ego/current/bin/miro-ego-encoder
Environment=RUST_LOG=info
EnvironmentFile=-/etc/default/miro-ego-data-volume
ExecStart=/opt/miro-ego/current/bin/miro-ego serve --config /etc/miro-ego/device.json
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=miro-ego
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/miro-ego
ReadWritePaths=-/data
ReadWritePaths=/run/miro-ego/network-operation.lock
ReadWritePaths=/run/miro-ego/maintenance.lock
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
